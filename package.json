		"@tensorflow-models/mobilenet": "^2.1.1",
		"@tensorflow/tfjs": "^4.22.0",
		"@types/axios": "^0.14.4",
		"@xenova/transformers": "^2.17.2",
		"axios": "^1.20.0",
		"dotenv": "^18.0.5",
		"file-saver": "^2.0.5",
		"jspdf": "^4.2.1",
		"jszip": "^3.10.2",
		"mongodb": "^7.6.0",
		"mongoose": "^9.10.4",
		"swagger-ui-dist": "^5.32.14"
	}
}
